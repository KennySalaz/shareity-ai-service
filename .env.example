# Copy to .env (local) or set these in Render's Environment tab.
# NEVER commit the real key.

# OpenRouter credential (account with credit). Server-side only.
OPENROUTER_API_KEY=

# Text model(s), paid on OpenRouter. AI_TEXT_MODELS (comma-separated) accepts a
# fallback chain; AI_TEXT_MODEL a single model. Default: anthropic/claude-sonnet-5.
# AI_TEXT_MODELS=anthropic/claude-opus-5,anthropic/claude-sonnet-5

# Image model for badges and covers (OpenRouter, spends credit).
# AI_IMAGE_MODEL=google/gemini-3.1-flash-image

# Who is allowed to call this API from the browser.
# "*" is fine for a quick demo; set your dashboard origin for anything real,
# e.g. https://appdev.shareity.com — otherwise any site can spend your credit.
ALLOWED_ORIGIN=*

# Sent to OpenRouter as HTTP-Referer / attribution. Optional.
APP_URL=https://appdev.shareity.com

# Local port (Render sets PORT automatically).
PORT=8787
